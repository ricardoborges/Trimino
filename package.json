{
  "name": "trimino",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w server & npm run dev -w web",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "test": "vitest run",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p web",
    "smoke": "tsx scripts/smoke.ts",
    "fixtures": "node scripts/capture-fixtures.mjs",
    "deploy": "npm run build && npm run deploy -w server",
    "db:migrate": "npm run db:migrate -w server"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "ws": "^8.22.0"
  }
}
