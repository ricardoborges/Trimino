# Copie para server/.env e preencha. Este arquivo (.env.example) vai para o git; o .env não.

# Chave da API da DeepSeek usada pelos jogadores IA. Sem ela, os robôs jogam a jogada de maior pontuação.
DEEPSEEK_API_KEY=

# Modelo da DeepSeek (padrão: deepseek-flash, o DeepSeek V4.1 Flash).
# DEEPSEEK_MODEL=deepseek-flash

# Porta do servidor (padrão 8080).
# PORT=8080
