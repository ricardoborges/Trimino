// Triminó na Cloudflare: Worker (API, login e WebSocket), Durable Objects (uma mesa por objeto)
// e D1 (contas, sessões, lista da varanda e estatísticas). O cliente compilado (web/dist) sai como assets.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "trimino",
  "main": "src/worker.ts",
  "compatibility_date": "2025-10-01",
  // nodejs_compat também preenche process.env com as variáveis e secrets (usado pela IA).
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    // Rotas como /varanda e /mesa/ABCDE caem no index.html; API, login e WebSocket vão para o Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [{ "name": "MESA", "class_name": "Mesa" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Mesa"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trimino",
      "database_id": "84f18f5a-ab90-4e6d-9d76-29d11327edfd",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
